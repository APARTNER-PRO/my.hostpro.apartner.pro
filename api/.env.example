# =============================================================================
#  РЕЖИМ ДЕПЛОЮ
# =============================================================================
#
#  Варіант A — фронт і бек в одній папці на одному домені:
#    DEPLOY_MODE=same-domain
#    FRONTEND_URL=https://programist.com.ua
#    BACKEND_URL=https://programist.com.ua
#
#  Варіант B — фронт на Vercel, бек на окремому домені:
#    DEPLOY_MODE=split
#    FRONTEND_URL=https://billing.vercel.app
#    BACKEND_URL=https://programist.com.ua
#
# =============================================================================

DEPLOY_MODE=split

# URL фронтенду (без слешу в кінці)
FRONTEND_URL=https://your-project.vercel.app

# URL бекенду (без слешу в кінці)
BACKEND_URL=https://programist.com.ua

# Додаткові дозволені origins через кому (напр. localhost для розробки)
EXTRA_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
#  JWT
# =============================================================================
JWT_SECRET=replace_with_32_random_chars_here_!!
JWT_TTL=86400

# =============================================================================
#  PADDLE
# =============================================================================
# Paddle Billing v2: Dashboard → Developer Tools → API keys
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_ENV=sandbox
# sandbox → https://sandbox-api.paddle.com
# production → https://api.paddle.com

# Тільки для Paddle Classic (v1)
PADDLE_VENDOR_ID=

# Paddle Dashboard → Notifications → Webhooks → Secret key
PADDLE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
#  ADMIN
# =============================================================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=strong_password_here

# =============================================================================
#  DATABASE  (DB_DRIVER=sqlite|mariadb)
# =============================================================================
DB_DRIVER=sqlite

# SQLite
DB_PATH=/var/www/billing/backend/database/billing.sqlite

# MariaDB 10.6 (розкоментуй якщо DB_DRIVER=mariadb)
# DB_DRIVER=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=billing
# DB_USER=billing_user
# DB_PASS=strong_db_password
# DB_CHARSET=utf8mb4

# =============================================================================
#  EMAIL / SMTP
# =============================================================================
MAIL_FROM=noreply@programist.com.ua
MAIL_FROM_NAME=Programist Hosting

# SMTP (якщо не заповнено — використовується PHP mail())
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=app_password_here

# =============================================================================
#  WHM / cPanel
# =============================================================================
WHM_HOST=rocket-cms3.hostsila.org
WHM_USER=xhkazoyb
WHM_TOKEN=your_whm_api_token_here
WHM_PLAN=xhkazoyb_Personal
# Префікс домену для нових акаунтів: username.DOMAIN_PREFIX
WHM_DOMAIN_PREFIX=clients.programist.com.ua

# =============================================================================
#  OPENROUTER AI (для авто-відповідей в тікетах)
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
